rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
// departments: slug, name, full_name, description, image_url (strings),
//   objectives/responsibilities (lists), is_active (bool), display_order (int),
//   created_at/updated_at (ISO strings)
// teams: department_id, title (strings), display_order (int)
// members: team_id, name, role, image_url (strings), socials (map), display_order (int)
// events: title, description, date, time, location, category, status, image_url,
//   registration_url, created_at (strings), is_featured (bool)
// classes: slug, title, description, schedule, time, venue, fee, image_url,
//   registration_url, created_at (strings), students_enrolled (int), objectives (list),
//   is_active (bool)
// blog_posts: slug, title, excerpt, content, category, author, status,
//   featured_image_url, created_at, updated_at (strings), published_at (string or null)
// site_settings: key, value, updated_at (strings)
// authorized_admins: email, uid, display_name, status, added_by, created_at,
//   updated_at, last_signed_in_at. Contains private access-control data and is
//   only managed through Firebase Admin SDK route handlers.
// committee_applications / committee_registration_config: applicant personal
//   data and form settings. Only accessed through Admin SDK route handlers, so
//   the catch-all rule below denies all browser access.
// Website-content collections are public to support the public site. Only a
// verified allowlisted administrator may write.

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && 'uid' in resource.data && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        (('uid' in resource.data) && request.resource.data.uid == resource.data.uid);
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        (
          request.auth.token.email == 'sopgok9@gmail.com' ||
          isActiveAddedAdmin(request.auth.token.email)
        );
    }

    function isActiveAddedAdmin(email) {
      let path = /databases/$(database)/documents/authorized_admins/$(email);
      return exists(path) &&
        get(path).data.email == email &&
        get(path).data.uid == request.auth.uid &&
        get(path).data.status == 'active';
    }

    function validString(value, minLength, maxLength) {
      return value is string && value.size() >= minLength && value.size() <= maxLength;
    }

    function validExternalUrl(value) {
      return value is string && value.size() <= 2048 &&
        (value == '' || value.matches('^https://.*'));
    }

    function validImageUrl(value) {
      return value is string && value.size() <= 2048 &&
        (value == '' ||
          value.matches('^/images/.*') ||
          value.matches('^https://firebasestorage.googleapis.com/v0/b/alqisc-a2999.firebasestorage.app/o/.*'));
    }

    function validIsoDate(value) {
      return value is string && value.size() <= 40 &&
        value.matches('^\\d{4}-\\d{2}-\\d{2}.*');
    }

    function validDisplayOrder(value) {
      return value is int && value >= 0 && value <= 10000;
    }

    function validStringList(value, maxItems) {
      return value is list && value.size() <= maxItems;
    }

    function validSocials(value) {
      return value is map && value.size() <= 4 &&
        value.keys().hasOnly([
          'instagram', 'facebook', 'twitter', 'linkedin',
          'github', 'email', 'phone', 'website'
        ]) &&
        (!('instagram' in value) || validString(value.instagram, 1, 300)) &&
        (!('facebook' in value) || validString(value.facebook, 1, 300)) &&
        (!('twitter' in value) || validString(value.twitter, 1, 300)) &&
        (!('linkedin' in value) || validString(value.linkedin, 1, 300)) &&
        (!('github' in value) || validString(value.github, 1, 300)) &&
        (!('email' in value) || validString(value.email, 3, 254)) &&
        (!('phone' in value) || validString(value.phone, 3, 50)) &&
        (!('website' in value) || validString(value.website, 1, 300));
    }

    // ===============================================================
    // Domain Validators — used for both create and update
    // ===============================================================
    function isValidDepartment(data) {
      return data.keys().hasAll([
          'slug', 'name', 'full_name', 'description', 'image_url',
          'objectives', 'responsibilities', 'is_active', 'display_order',
          'created_at', 'updated_at'
        ]) &&
        data.keys().hasOnly([
          'slug', 'name', 'full_name', 'description', 'image_url',
          'objectives', 'responsibilities', 'is_active', 'display_order',
          'created_at', 'updated_at'
        ]) &&
        validString(data.slug, 1, 100) &&
        data.slug.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$') &&
        validString(data.name, 1, 100) &&
        validString(data.full_name, 1, 200) &&
        validString(data.description, 0, 20000) &&
        validImageUrl(data.image_url) &&
        validStringList(data.objectives, 50) &&
        validStringList(data.responsibilities, 50) &&
        data.is_active is bool &&
        validDisplayOrder(data.display_order) &&
        validIsoDate(data.created_at) && validIsoDate(data.updated_at);
    }

    function isValidTeam(data) {
      return data.keys().hasAll(['department_id', 'title', 'display_order']) &&
        data.keys().hasOnly(['department_id', 'title', 'display_order']) &&
        validString(data.department_id, 1, 128) &&
        validString(data.title, 1, 200) &&
        validDisplayOrder(data.display_order);
    }

    function isValidMember(data) {
      return data.keys().hasAll([
          'team_id', 'name', 'role', 'image_url', 'socials', 'display_order'
        ]) &&
        data.keys().hasOnly([
          'team_id', 'name', 'role', 'image_url', 'socials', 'display_order'
        ]) &&
        validString(data.team_id, 1, 128) &&
        validString(data.name, 1, 150) &&
        validString(data.role, 0, 150) &&
        validImageUrl(data.image_url) &&
        validSocials(data.socials) &&
        validDisplayOrder(data.display_order);
    }

    function isValidEvent(data) {
      return data.keys().hasAll([
          'title', 'description', 'date', 'time', 'location', 'category',
          'status', 'image_url', 'is_featured', 'registration_url', 'created_at'
        ]) &&
        data.keys().hasOnly([
          'title', 'description', 'date', 'time', 'location', 'category',
          'status', 'image_url', 'is_featured', 'registration_url', 'created_at'
        ]) &&
        validString(data.title, 1, 250) &&
        validString(data.description, 0, 30000) &&
        validString(data.date, 10, 40) &&
        validString(data.time, 0, 100) &&
        validString(data.location, 0, 300) &&
        data.category in ['weekly', 'monthly', 'special'] &&
        data.status in ['upcoming', 'past', 'cancelled'] &&
        validImageUrl(data.image_url) &&
        data.is_featured is bool &&
        validExternalUrl(data.registration_url) &&
        validIsoDate(data.created_at);
    }

    function isValidClass(data) {
      return data.keys().hasAll([
          'slug', 'title', 'description', 'schedule', 'time', 'venue', 'fee',
          'students_enrolled', 'image_url', 'objectives', 'registration_url',
          'is_active', 'created_at'
        ]) &&
        data.keys().hasOnly([
          'slug', 'title', 'description', 'schedule', 'time', 'venue', 'fee',
          'students_enrolled', 'image_url', 'objectives', 'registration_url',
          'is_active', 'created_at'
        ]) &&
        validString(data.slug, 1, 100) &&
        data.slug.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$') &&
        validString(data.title, 1, 250) &&
        validString(data.description, 0, 30000) &&
        validString(data.schedule, 0, 200) &&
        validString(data.time, 0, 100) &&
        validString(data.venue, 0, 300) &&
        validString(data.fee, 0, 100) &&
        data.students_enrolled is int &&
        data.students_enrolled >= 0 && data.students_enrolled <= 100000 &&
        validImageUrl(data.image_url) &&
        validStringList(data.objectives, 50) &&
        validExternalUrl(data.registration_url) &&
        data.is_active is bool &&
        validIsoDate(data.created_at);
    }

    function isValidBlogPost(data) {
      return data.keys().hasAll([
          'slug', 'title', 'excerpt', 'content', 'category', 'author', 'status',
          'featured_image_url', 'published_at', 'created_at', 'updated_at'
        ]) &&
        data.keys().hasOnly([
          'slug', 'title', 'excerpt', 'content', 'category', 'author', 'status',
          'featured_image_url', 'published_at', 'created_at', 'updated_at'
        ]) &&
        validString(data.slug, 1, 150) &&
        data.slug.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$') &&
        validString(data.title, 1, 300) &&
        validString(data.excerpt, 0, 2000) &&
        validString(data.content, 0, 500000) &&
        validString(data.category, 1, 100) &&
        validString(data.author, 1, 150) &&
        data.status in ['draft', 'published', 'archived'] &&
        validImageUrl(data.featured_image_url) &&
        (data.published_at == null || validIsoDate(data.published_at)) &&
        validIsoDate(data.created_at) && validIsoDate(data.updated_at);
    }

    function isValidSiteSetting(data, documentId) {
      return data.keys().hasAll(['key', 'value', 'updated_at']) &&
        data.keys().hasOnly(['key', 'value', 'updated_at']) &&
        validString(data.key, 1, 100) &&
        data.key == documentId &&
        validString(data.value, 0, 10000) &&
        (!(data.key in ['hero_image', 'advisor_image', 'donation_qr']) ||
          validImageUrl(data.value)) &&
        validIsoDate(data.updated_at);
    }

    match /departments/{documentId} {
      allow read: if true;
      allow create: if isAdmin() && uidUnchanged() && isValidDepartment(request.resource.data);
      allow update: if isAdmin() && uidNotModified() &&
        request.resource.data.created_at == resource.data.created_at &&
        isValidDepartment(request.resource.data);
      allow delete: if isAdmin();
    }

    match /teams/{documentId} {
      allow read: if true;
      allow create: if isAdmin() && uidUnchanged() && isValidTeam(request.resource.data);
      allow update: if isAdmin() && uidNotModified() && isValidTeam(request.resource.data);
      allow delete: if isAdmin();
    }

    match /members/{documentId} {
      allow read: if true;
      allow create: if isAdmin() && uidUnchanged() && isValidMember(request.resource.data);
      allow update: if isAdmin() && uidNotModified() && isValidMember(request.resource.data);
      allow delete: if isAdmin();
    }

    match /events/{documentId} {
      allow read: if true;
      allow create: if isAdmin() && uidUnchanged() && isValidEvent(request.resource.data);
      allow update: if isAdmin() && uidNotModified() &&
        request.resource.data.created_at == resource.data.created_at &&
        isValidEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    match /classes/{documentId} {
      allow read: if true;
      allow create: if isAdmin() && uidUnchanged() && isValidClass(request.resource.data);
      allow update: if isAdmin() && uidNotModified() &&
        request.resource.data.created_at == resource.data.created_at &&
        isValidClass(request.resource.data);
      allow delete: if isAdmin();
    }

    match /blog_posts/{documentId} {
      allow read: if true;
      allow create: if isAdmin() && uidUnchanged() && isValidBlogPost(request.resource.data);
      allow update: if isAdmin() && uidNotModified() &&
        request.resource.data.created_at == resource.data.created_at &&
        isValidBlogPost(request.resource.data);
      allow delete: if isAdmin();
    }

    match /site_settings/{documentId} {
      allow read: if true;
      allow create: if isAdmin() && uidUnchanged() && isValidSiteSetting(request.resource.data, documentId);
      allow update: if isAdmin() && uidNotModified() && isValidSiteSetting(request.resource.data, documentId);
      allow delete: if isAdmin();
    }

    // Email addresses and access-control metadata are never exposed to the
    // browser SDK. The trusted server uses Firebase Admin SDK for management.
    match /authorized_admins/{email} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
