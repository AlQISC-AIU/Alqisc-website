rules_version = '2';

// One ruleset for the shared AL-QISC database (al-qisc-prod / al-qisc-dev).
// The website and the mobile app both read from it. This repo is the only place
// that deploys it, because a deploy replaces the whole ruleset for both.
// Run `npm run test:rules` before every deploy.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Mobile app feed --------------------------------------------------
    // Every installed app version reads public_content without signing in and
    // queries status == 'published'. Keep these rules exactly as the app needs
    // them. isFeedAdmin() serves the Flutter admin until it is retired.
    function isFeedAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in
            get(/databases/$(database)/documents/admin_config/allowlist).data.emails;
    }

    match /public_content/{contentId} {
      allow read: if resource.data.status == 'published' || isFeedAdmin();
      allow write: if isFeedAdmin();
    }

    match /public_config/{configId} {
      allow read: if true;
      allow write: if isFeedAdmin();
    }

    match /admin_config/allowlist {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ---- Website content --------------------------------------------------
    // Public pages read these without signing in. The website's server writes
    // them with the Admin SDK, which skips these rules, so browsers never write.
    match /departments/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /teams/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /members/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /classes/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /blog_posts/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /site_settings/{key} {
      allow read: if true;
      allow write: if false;
    }

    // authorized_admins, committee_applications, committee_registration_config
    // and private_config are server-only and fall through to the deny below.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
