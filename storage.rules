rules_version = '2';

// Storage rules for the shared AL-QISC bucket. Deployed only from this repo.
service firebase.storage {
  match /b/{bucket}/o {

    // Mobile app feed images, uploaded by the Flutter admin until it is retired.
    // Kept exactly as the app repo had them.
    match /public_content/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified
        && request.auth.token.email in ['aqc@student.aiu.edu.my', 'mansourshakla@gmail.com']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Website images. The website's server uploads them with the Admin SDK and
    // links them with tokenized download URLs, so browsers never write here.
    match /images/{folder}/{fileName} {
      allow read: if folder in [
        'departments', 'members', 'events', 'classes', 'blog', 'settings', 'migrated', 'feed'
      ];
      allow write: if false;
    }

    // Everything else, including private committee applicant photos.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
