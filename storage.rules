rules_version = '2';

// Storage rules for the shared AL-QISC bucket. Deployed only from this repo.
service firebase.storage {
  match /b/{bucket}/o {

    // Mobile app feed images, uploaded by the Flutter admin until it is retired.
    // Kept exactly as the app repo had them.
    match /public_content/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified
        && request.auth.token.email in ['aqc@student.aiu.edu.my', 'mansourshakla@gmail.com']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Website images. The website's server uploads them with the Admin SDK and
    // links them with tokenized download URLs, so browsers never write here.
    match /images/{folder}/{fileName} {
      allow read: if folder in [
        'departments', 'members', 'events', 'classes', 'blog', 'settings', 'migrated', 'feed'
      ];
      allow write: if false;
    }

    // Formal pictures for committee applications, uploaded by the applicant's
    // browser because they can be larger than the website's server accepts.
    // The server checks the application first and writes a ticket to Firestore
    // (committee_upload_tickets, which browsers cannot read or write). A
    // browser may then create exactly the file that ticket describes, once.
    // Nobody can read, replace or delete an upload from a browser; the server
    // moves it into the private committee-applications/ folder on submission.
    function uploadTicket(ticketId) {
      return firestore.get(/databases/(default)/documents/committee_upload_tickets/$(ticketId));
    }

    match /committee-application-uploads/{ticketId}/photo {
      allow create: if request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && firestore.exists(/databases/(default)/documents/committee_upload_tickets/$(ticketId))
        && uploadTicket(ticketId).data.expires_at > request.time
        && uploadTicket(ticketId).data.size == request.resource.size
        && uploadTicket(ticketId).data.content_type == request.resource.contentType;
      allow read, update, delete: if false;
    }

    // Everything else, including private committee applicant photos.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
