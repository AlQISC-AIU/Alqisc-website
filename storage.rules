rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        (
          request.auth.token.email == 'sopgok9@gmail.com' ||
          isActiveAddedAdmin(request.auth.token.email)
        );
    }

    function isActiveAddedAdmin(email) {
      let path = /databases/(default)/documents/authorized_admins/$(email);
      return firestore.exists(path) &&
        firestore.get(path).data.email == email &&
        firestore.get(path).data.uid == request.auth.uid &&
        firestore.get(path).data.status == 'active';
    }

    function isAllowedFolder(folder) {
      return folder in [
        'departments', 'members', 'events', 'classes', 'blog', 'settings', 'migrated'
      ];
    }

    function isValidImage(fileName) {
      return fileName.matches('^[A-Za-z0-9._-]{1,200}$') &&
        request.resource.size > 0 &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg', 'image/png', 'image/webp', 'image/gif'
        ];
    }

    match /images/{folder}/{fileName} {
      allow read: if isAllowedFolder(folder);
      // All writes go through /api/admin/images where role and department
      // scope are verified server-side. Browser SDK writes are denied.
      allow create, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
